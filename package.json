{
  "name": "mujez_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mujez multi-tenant CRM modular monolith",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "openapi:generate": "npm run build && node scripts/openapi.mjs",
    "format": "prettier --write src tests scripts docs tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts docs tsconfig.json package.json",
    "db:provision:local": "node --env-file-if-exists=.env scripts/provision-local-roles.mjs",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "db:seed:companies": "npm run build && node --env-file-if-exists=.env scripts/seed-companies.mjs",
    "db:seed:subscriptions": "npm run build && node --env-file-if-exists=.env scripts/seed-subscriptions.mjs",
    "db:seed:billing": "npm run build && node --env-file-if-exists=.env scripts/seed-billing.mjs",
    "db:seed:features": "npm run build && node --env-file-if-exists=.env scripts/seed-features.mjs",
    "db:seed:integrations": "npm run build && node --env-file-if-exists=.env scripts/seed-integrations.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "^0.5.12",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
