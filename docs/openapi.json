  "info": {
    "title": "Mujez CRM Foundation API",
    "description": "Foundation endpoints only. Business modules and controlled support access are not implemented yet.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "platform": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-mujez_session"
      },
      "tenant": { "type": "apiKey", "in": "cookie", "name": "mujez_session" }
    },
    "schemas": {
      "LoginDto": { "type": "object", "properties": {} },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "pool": {
            "type": "string",
            "enum": ["company_admin", "company_user", "platform"]
          },
          "companyId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": ["own", "team", "company", "platform"]
          },
          "teamId": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": ["id", "pool", "name", "email", "role", "scope"]
      },
      "TenantPermissionsDto": {
        "type": "object",
        "properties": {
          "permissions": { "type": "array", "items": { "type": "string" } },
          "scope": { "type": "string", "enum": ["own", "team", "company"] },
          "teamId": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": ["permissions", "scope", "teamId"]
      },
      "PermissionsDto": {
        "type": "object",
        "properties": {
          "permissions": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["permissions"]
      },
      "CompanyInput": {
        "type": "object",
        "properties": {
          "nameEn": { "type": "string" },
          "nameAr": { "type": "string" },
          "slug": { "type": "string" },
          "type": { "type": "string" },
          "city": { "type": "string" },
          "adminEmail": { "type": "string" },
          "phone": { "type": "string" },
          "website": { "type": "string" },
          "plan": { "type": "string" }
        },
        "required": [
          "nameEn",
          "nameAr",
          "slug",
          "type",
          "city",
          "adminEmail",
          "phone",
          "website",
          "plan"
        ]
      },
      "CompanyUpdate": {
        "type": "object",
        "properties": {
          "nameEn": { "type": "string" },
          "nameAr": { "type": "string" },
          "slug": { "type": "string" },
          "type": { "type": "string" },
          "city": { "type": "string" },
          "adminEmail": { "type": "string" },
          "phone": { "type": "string" },
          "website": { "type": "string" },
          "plan": { "type": "string" },
          "version": { "type": "number" }
        },
        "required": [
          "nameEn",
          "nameAr",
          "slug",
          "type",
          "city",
          "adminEmail",
          "phone",
          "website",
          "plan",
          "version"
        ]
      },
      "StatusInput": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "version": { "type": "number" },
          "reason": { "type": "string" }
        },
        "required": ["action", "version", "reason"]
      },
      "StepInput": {
        "type": "object",
        "properties": {
          "step": { "type": "string" },
          "completed": { "type": "boolean" },
          "version": { "type": "number" }
        },
        "required": ["step", "completed", "version"]
      },
      "PlanCreate": {
        "type": "object",
        "properties": {
          "nameEn": { "type": "string" },
          "nameAr": { "type": "string" },
          "descEn": { "type": "string" },
          "descAr": { "type": "string" },
          "monthlyMinor": { "type": "number" },
          "annualMinor": { "type": "number" },
          "users": { "type": "object" },
          "listings": { "type": "object" },
          "projects": { "type": "object" },
          "storageGb": { "type": "object" },
          "featsEn": { "type": "string" },
          "featsAr": { "type": "string" },
          "key": { "type": "string" }
        },
        "required": [
          "nameEn",
          "nameAr",
          "descEn",
          "descAr",
          "monthlyMinor",
          "annualMinor",
          "users",
          "listings",
          "projects",
          "storageGb",
          "featsEn",
          "featsAr",
          "key"
        ]
      },
      "PlanEdit": {
        "type": "object",
        "properties": {
          "nameEn": { "type": "string" },
          "nameAr": { "type": "string" },
          "descEn": { "type": "string" },
          "descAr": { "type": "string" },
          "monthlyMinor": { "type": "number" },
          "annualMinor": { "type": "number" },
          "users": { "type": "object" },
          "listings": { "type": "object" },
          "projects": { "type": "object" },
          "storageGb": { "type": "object" },
          "featsEn": { "type": "string" },
          "featsAr": { "type": "string" },
          "version": { "type": "number" },
          "scope": { "type": "string" },
          "selectedIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "nameEn",
          "nameAr",
          "descEn",
          "descAr",
          "monthlyMinor",
          "annualMinor",
          "users",
          "listings",
          "projects",
          "storageGb",
          "featsEn",
          "featsAr",
          "version",
          "scope",
          "selectedIds"
        ]
      },
      "PlanArchive": {
        "type": "object",
        "properties": {
          "version": { "type": "number" },
          "archived": { "type": "boolean" }
        },
        "required": ["version", "archived"]
      },
      "SubscriptionCreate": {
        "type": "object",
        "properties": {
          "companyId": { "type": "string" },
          "plan": { "type": "string" },
          "cycle": { "type": "string" },
          "payment": { "type": "string" },
          "status": { "type": "string" },
          "planVersionId": { "type": "string" }
        },
        "required": [
          "companyId",
          "plan",
          "cycle",
          "payment",
          "status",
          "planVersionId"
        ]
      },
      "SubscriptionChange": {
        "type": "object",
        "properties": {
          "version": { "type": "number" },
          "plan": { "type": "string" },
          "planVersionId": { "type": "string" }
        },
        "required": ["version", "plan", "planVersionId"]
      },
      "Revision": {
        "type": "object",
        "properties": { "version": { "type": "number" } },
        "required": ["version"]
      }
    }
  }
}
