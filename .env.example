NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql://mujez_tenant:tenant_local_only@localhost:5432/mujez
PLATFORM_DATABASE_URL=postgresql://mujez_platform:platform_local_only@localhost:5432/mujez
# Used only by migration/provisioning commands; never consumed by the API.
MIGRATION_DATABASE_URL=postgresql://mujez_owner:owner_local_only@localhost:5432/mujez
REDIS_URL=redis://localhost:6379

# Automatic owner welcome emails. Required for company creation.
MAIL_ENABLED=false
# Set MAIL_ENABLED=true and provide these values privately to enable it:
# SMTP_HOST=mail.mujez.net
# SMTP_PORT=587
# SMTP_USER=info@mujez.net
# SMTP_PASSWORD=your-private-smtp-password
# Staging worker alternatively mounts SMTP_PASSWORD_FILE=/run/mujez-mail-smtp/password
# WELCOME_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# DASHBOARD_URL=https://mujez-stg.mujez.net/
