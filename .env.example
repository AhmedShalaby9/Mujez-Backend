NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql://mujez_tenant:tenant_local_only@localhost:5432/mujez
PLATFORM_DATABASE_URL=postgresql://mujez_platform:platform_local_only@localhost:5432/mujez
# Used only by migration/provisioning commands; never consumed by the API.
MIGRATION_DATABASE_URL=postgresql://mujez_owner:owner_local_only@localhost:5432/mujez
REDIS_URL=redis://localhost:6379
AUTH_COMPANY_ADMIN_ISSUER=http://localhost:8080/realms/company-admins
AUTH_COMPANY_ADMIN_AUDIENCE=mujez-crm
AUTH_COMPANY_ADMIN_JWKS_URL=http://localhost:8080/realms/company-admins/protocol/openid-connect/certs
AUTH_COMPANY_USER_ISSUER=http://localhost:8080/realms/company-users
AUTH_COMPANY_USER_AUDIENCE=mujez-crm
AUTH_COMPANY_USER_JWKS_URL=http://localhost:8080/realms/company-users/protocol/openid-connect/certs
AUTH_PLATFORM_ISSUER=http://localhost:8080/realms/platform
AUTH_PLATFORM_AUDIENCE=mujez-admin
AUTH_PLATFORM_JWKS_URL=http://localhost:8080/realms/platform/protocol/openid-connect/certs
PLATFORM_IP_ALLOWLIST=127.0.0.1/32,::1/128
